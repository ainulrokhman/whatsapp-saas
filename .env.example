# Database (MySQL)
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
# Jika user root dan password kosong (contoh XAMPP/Laragon):
# DATABASE_URL="mysql://root:@localhost:3306/whatsapp_saas"
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Wajib cukup panjang untuk enkripsi JWT (512 bit). Generate: openssl rand -base64 64
NEXTAUTH_SECRET="generate-dengan-openssl-rand-base64-64"
